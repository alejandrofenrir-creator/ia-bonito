# ===== OBLIGATORIAS EN PRODUCCIÓN (Vercel → Settings → Environment Variables) =====

# Mínimo 32 caracteres aleatorios. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Clave del administrador (mínimo 10 caracteres). Si la cambias aquí y vuelves a desplegar,
# la contraseña del admin se actualiza. Nunca la escribas en el código.
ADMIN_PASSWORD=
ADMIN_USERNAME=Afenrir

GEMINI_API_KEY=tu_api_key_aqui

# ===== OPCIONALES =====

# Modelo de Gemini (por defecto gemini-3.6-flash). Los gemini-1.5/2.0/2.5 están retirados y se ignoran.
GEMINI_MODEL=gemini-3.6-flash

# Orígenes extra permitidos por CORS, separados por comas (la app en el mismo dominio no lo necesita).
ALLOWED_ORIGINS=

PORT=3000

# Base de datos: Vercel Storage → Upstash Redis crea estas variables automáticamente.
# Sin ellas, el servidor usa archivos JSON locales (solo sirve para desarrollo).
KV_REST_API_URL=
KV_REST_API_TOKEN=
